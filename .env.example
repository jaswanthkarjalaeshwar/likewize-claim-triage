# Required
OPENROUTER_API_KEY=

# Jev (TypeSafe). Without it, a small open model stands in with the same question format.
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest

# Optional model overrides, comma separated, first is primary
FAST_MODELS=google/gemma-4-26b-a4b-it,mistralai/mistral-small-2603
REASONING_MODELS=deepseek/deepseek-v4.1-flash,deepseek/deepseek-v4-pro-0813

# Memory
MEM0_API_KEY=

# Tracing
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

CLAIMS_PER_MINUTE=4
